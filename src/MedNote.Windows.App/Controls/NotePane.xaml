<UserControl
    x:Class="MedNote.Windows.App.Controls.NotePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource PaneBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Padding="12"
            Background="#FFF8FAFA"
            BorderBrush="{ThemeResource SubtleBorderBrush}"
            BorderThickness="0,0,1,0">
            <Grid RowSpacing="7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{ThemeResource MedNoteTealBrush}"
                        Text="THƯ VIỆN NOTE" />
                    <Button
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Click="OnCreateNotebookClicked"
                        Content="+"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="Tạo sổ ghi chú" />
                </Grid>
                <TextBlock Grid.Row="1" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" Text="Sổ ghi chú" />
                <ComboBox
                    x:Name="NotebookBox"
                    Grid.Row="2"
                    Height="34"
                    DisplayMemberPath="Title"
                    ItemsSource="{Binding Notebooks}"
                    SelectionChanged="OnNotebookSelectionChanged" />
                <TextBlock Grid.Row="3" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" Text="Phần" />
                <ComboBox
                    x:Name="SectionBox"
                    Grid.Row="4"
                    Height="34"
                    DisplayMemberPath="Title"
                    ItemsSource="{Binding Sections}"
                    SelectionChanged="OnSectionSelectionChanged" />
                <Grid Grid.Row="5" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" Text="Trang" />
                    <Button
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Click="OnCreatePageClicked"
                        Content="+"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="Tạo trang First Aid" />
                </Grid>
                <ComboBox
                    x:Name="PageBox"
                    Grid.Row="6"
                    Height="34"
                    DisplayMemberPath="Title"
                    ItemsSource="{Binding Pages}"
                    SelectionChanged="OnPageSelectionChanged" />
                <Grid Grid.Row="7" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="SheetBox"
                        Height="34"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding Sheets}"
                        SelectionChanged="OnSheetSelectionChanged" />
                    <Button
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Click="OnCreateSheetClicked"
                        Content="+"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="Thêm tờ" />
                </Grid>
                <Grid Grid.Row="8" Margin="0,12,0,0" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource MutedTextBrush}"
                        Text="NGUỒN PDF" />
                    <ListView
                        x:Name="SourceList"
                        Grid.Row="1"
                        IsItemClickEnabled="True"
                        ItemClick="OnSourceClicked"
                        ItemsSource="{Binding Sources}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{ThemeResource MedNoteNavyBrush}"
                                    Text="{Binding DisplayLabel}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    ToolTipService.ToolTip="Mở vị trí nguồn trong PDF" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Spacing="4">
                        <TextBlock
                            FontSize="10"
                            Foreground="{ThemeResource MutedTextBrush}"
                            Text="RTF native · tự động lưu"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="10"
                            Foreground="{ThemeResource MedNoteTealBrush}"
                            Text="{Binding StatusText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border
                Padding="14,6"
                Background="White"
                BorderBrush="{ThemeResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1">
                <TextBox
                    x:Name="PageTitleBox"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource MedNoteNavyBrush}"
                    LostFocus="OnPageTitleLostFocus"
                    Text="{Binding ActivePageTitle, Mode=OneWay}" />
            </Border>
            <Border
                Grid.Row="1"
                Padding="8,4"
                Background="#FFFDFEFE"
                BorderBrush="{ThemeResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Click="OnBoldClicked" Content="B" FontWeight="Bold" Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Đậm" />
                        <Button Click="OnItalicClicked" Content="I" FontStyle="Italic" Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Nghiêng" />
                        <Button Click="OnUnderlineClicked" Content="U̲" Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Gạch chân" />
                        <Border Width="1" Height="24" Margin="4,0" Background="{ThemeResource SubtleBorderBrush}" />
                        <Button Click="OnFontSizeClicked" Content="10" Style="{StaticResource ToolbarButtonStyle}" Tag="10" />
                        <Button Click="OnFontSizeClicked" Content="12" Style="{StaticResource ToolbarButtonStyle}" Tag="12" />
                        <Button Click="OnFontSizeClicked" Content="14" Style="{StaticResource ToolbarButtonStyle}" Tag="14" />
                        <Button Click="OnFontSizeClicked" Content="18" Style="{StaticResource ToolbarButtonStyle}" Tag="18" />
                        <Border Width="1" Height="24" Margin="4,0" Background="{ThemeResource SubtleBorderBrush}" />
                        <Button Click="OnBulletClicked" Content="• Danh sách" Style="{StaticResource ToolbarButtonStyle}" />
                        <Button Click="OnNumberedClicked" Content="1. Danh sách" Style="{StaticResource ToolbarButtonStyle}" />
                        <Border Width="1" Height="24" Margin="4,0" Background="{ThemeResource SubtleBorderBrush}" />
                        <Button Content="Bảng" Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Chèn bảng RTF có ô trống">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="OnInsertTableClicked" Tag="2x2" Text="2 × 2" />
                                    <MenuFlyoutItem Click="OnInsertTableClicked" Tag="3x2" Text="3 hàng × 2 cột" />
                                    <MenuFlyoutItem Click="OnInsertTableClicked" Tag="3x3" Text="3 × 3" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <ComboBox
                            x:Name="LayoutRatioBox"
                            Width="104"
                            Height="32"
                            SelectedIndex="0"
                            ToolTipService.ToolTip="Tỷ lệ cột cho khối mới">
                            <ComboBoxItem Content="Cột 30 / 70" Tag="0.3" />
                            <ComboBoxItem Content="Cột 50 / 50" Tag="0.5" />
                            <ComboBoxItem Content="Cột 70 / 30" Tag="0.7" />
                        </ComboBox>
                        <ComboBox
                            x:Name="RowHeightBox"
                            Width="88"
                            Height="32"
                            SelectedIndex="1"
                            ToolTipService.ToolTip="Chiều cao hàng cho khối mới">
                            <ComboBoxItem Content="Hàng 24" Tag="24" />
                            <ComboBoxItem Content="Hàng 36" Tag="36" />
                            <ComboBoxItem Content="Hàng 52" Tag="52" />
                        </ComboBox>
                        <Button
                            Padding="10,0"
                            Background="#FFFFE8E4"
                            Click="OnFirstAidClicked"
                            Content="First Aid"
                            Foreground="#FF8A3428"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTipService.ToolTip="Chèn khung First Aid native" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Grid.Row="2" Background="#FFEEF3F4">
                <Border
                    MaxWidth="900"
                    Margin="22"
                    Padding="28,20"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="White"
                    BorderBrush="#FFD6DFE2"
                    BorderThickness="1"
                    CornerRadius="4">
                    <RichEditBox
                        x:Name="Editor"
                        AcceptsReturn="True"
                        Background="White"
                        BorderThickness="0"
                        FontFamily="Segoe UI"
                        FontSize="12"
                        Foreground="#FF1C2933"
                        IsSpellCheckEnabled="True"
                        TextWrapping="Wrap" />
                </Border>
                <ProgressRing
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="{Binding IsBusy}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
