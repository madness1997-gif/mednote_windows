<UserControl
    x:Class="MedNote.Windows.App.Controls.PdfThumbnailPresenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="50"
    Height="68"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <Border
        Background="White"
        BorderBrush="#FFD8DCDE"
        BorderThickness="1"
        CornerRadius="2">
        <Grid>
            <Image
                x:Name="ThumbnailImage"
                Stretch="Uniform"
                AutomationProperties.Name="Hình thu nhỏ trang PDF" />
            <ProgressRing
                Width="18"
                Height="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{Binding IsThumbnailRendering}" />
        </Grid>
    </Border>
</UserControl>
