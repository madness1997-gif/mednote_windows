<Application
    x:Class="MedNote.Windows.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F5F8" />
                    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#FBFCFE" />
                    <SolidColorBrush x:Key="ReaderBackgroundBrush" Color="#E8EBF0" />
                    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#D8DDE5" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#626B78" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#15181C" />
                    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#1C2025" />
                    <SolidColorBrush x:Key="ReaderBackgroundBrush" Color="#101215" />
                    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#343A43" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#AAB2BE" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="ToolbarToggleStyle" TargetType="ToggleButton">
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
