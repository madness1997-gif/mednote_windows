                    </Grid>
                </Border>

                <Grid
                    x:Name="ReaderSurface"
                    Grid.Row="1"
                    AllowDrop="True"
                    Background="{ThemeResource ReaderBackgroundBrush}"
                    DragOver="OnReaderDragOver"
                    Drop="OnReaderDrop">
                    <Grid x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel MaxWidth="430" HorizontalAlignment="Center" Spacing="10">
                            <Border
                                Width="58"
                                Height="58"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource SelectedBrush}"
                                CornerRadius="16">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    Foreground="{ThemeResource MedNoteTealBrush}"
                                    Glyph="&#xEA90;" />
                            </Border>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource MedNoteNavyBrush}"
                                Text="Mở tài liệu để bắt đầu đọc" />
                            <TextBlock
                                Foreground="{ThemeResource MutedTextBrush}"
                                Text="Kéo thả PDF vào đây hoặc bấm Mở PDF. Vị trí đọc được lưu tự động trên máy."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <Button
                                Height="36"
                                Margin="0,5,0,0"
                                Padding="14,0"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource MedNoteTealBrush}"
                                BorderThickness="0"
                                Click="OnOpenClicked"
                                Content="Mở PDF"
                                CornerRadius="8"
                                Foreground="White" />
                        </StackPanel>
                    </Grid>

                    <ListView
                        x:Name="ContinuousPagesList"
                        Padding="24"
                        HorizontalContentAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.Pages, Mode=OneWay}"
                        SelectionMode="None"
                        Visibility="Collapsed">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel AreStickyGroupHeadersEnabled="False" CacheLength="1.5" Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="IsTabStop" Value="False" />
                                <Setter Property="Margin" Value="0,0,0,22" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PdfPageViewModel">
                                <controls:PdfPagePresenter />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ScrollViewer
                        x:Name="SinglePageScrollViewer"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled"
                        Visibility="Collapsed"
                        ZoomMode="Disabled">
                        <Grid Padding="24">
                            <controls:PdfPagePresenter DataContext="{x:Bind ViewModel.CurrentPageItem, Mode=OneWay}" />
                        </Grid>
                    </ScrollViewer>

                    <Border x:Name="BusyOverlay" Background="#3A18324A" Visibility="Collapsed">
                        <Border
                            Width="185"
                            Height="54"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="White"
                            CornerRadius="10">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                <ProgressRing Width="22" Height="22" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                                <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource MedNoteNavyBrush}" Text="Đang mở PDF…" />
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
                </Grid>
                <Border
                    x:Name="WorkspaceDivider"
                    Grid.Column="1"
                    Background="#FFD5E0E2"
                    Visibility="Collapsed" />
                <controls:NotePane
                    x:Name="NoteWorkspacePane"
                    Grid.Column="2"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
