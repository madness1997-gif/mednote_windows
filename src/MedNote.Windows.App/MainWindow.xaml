                                            IconData="M8.3 10a.7.7 0 0 1-.626-1.079L11.4 3a.7.7 0 0 1 1.198-.043L16.3 8.9a.7.7 0 0 1-.572 1.1Z M4 14h5q1 0 1 1v5q0 1 -1 1h-5q-1 0 -1 -1v-5q0 -1 1 -1Z M14 17.5a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0 -7 0"
