<Window
    x:Class="MedNote.Windows.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MedNote.Windows.App.Controls"
    xmlns:core="using:MedNote.Core"
    xmlns:vm="using:MedNote.Windows.App.ViewModels"
    Title="MedNote Reader">
    <Grid
        x:Name="Root"
        Background="{ThemeResource AppBackgroundBrush}"
        KeyDown="OnRootKeyDown"
        Loaded="OnRootLoaded"
        RequestedTheme="Light">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="18,0"
            Background="White"
            BorderBrush="{ThemeResource SubtleBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" MinWidth="0" Orientation="Horizontal" Spacing="10">
                    <Button
                        Width="36"
                        Height="36"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnShowRailClicked"
                        ToolTipService.ToolTip="Mở bảng điều hướng">
                        <FontIcon FontSize="19" Glyph="&#xE700;" />
                    </Button>
                    <Border
                        Width="30"
                        Height="30"
                        VerticalAlignment="Center"
                        Background="{ThemeResource MedNoteTealBrush}"
                        CornerRadius="9">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="M" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="21"
                        FontWeight="Bold"
                        Foreground="{ThemeResource MedNoteTealBrush}"
                        Text="MedNote" />
                    <Border
                        Width="1"
                        Height="26"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleBorderBrush}" />
                    <Button
                        MaxWidth="430"
                        MinWidth="120"
                        Height="36"
                        Padding="9,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnOpenClicked"
                        CornerRadius="8"
                        HorizontalContentAlignment="Left"
                        ToolTipService.ToolTip="Chọn tài liệu">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock
                                MaxWidth="380"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource MedNoteNavyBrush}"
                                Text="{x:Bind ViewModel.DocumentName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <FontIcon FontSize="12" Glyph="&#xE70D;" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Border
                        Height="34"
                        VerticalAlignment="Center"
                        Background="#FFF7F9FA"
                        BorderBrush="#FFCBD9DC"
                        BorderThickness="1"
                        CornerRadius="9">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton
                                x:Name="SplitWorkspaceButton"
                                Height="32"
                                Padding="9,0"
                                BorderThickness="0"
                                Click="OnSplitWorkspaceClicked"
                                Content="Cả hai"
                                FontSize="10"
                                FontWeight="SemiBold"
                                ToolTipService.ToolTip="Reader và Note cạnh nhau" />
                            <Border Width="1" Background="#FFDCE5E7" />
                            <ToggleButton
                                x:Name="ReaderWorkspaceButton"
                                Height="32"
                                Padding="9,0"
                                BorderThickness="0"
                                Click="OnReaderWorkspaceClicked"
                                FontSize="10"
                                FontWeight="SemiBold"
                                IsChecked="True">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon FontSize="15" Glyph="&#xE736;" />
                                    <TextBlock VerticalAlignment="Center" Text="Reader" />
                                </StackPanel>
                            </ToggleButton>
                            <Border Width="1" Background="#FFDCE5E7" />
                            <ToggleButton
                                x:Name="NoteWorkspaceButton"
                                Height="32"
                                Padding="9,0"
                                BorderThickness="0"
                                Click="OnNoteWorkspaceClicked"
                                Content="Note"
                                FontSize="10"
                                FontWeight="SemiBold"
                                ToolTipService.ToolTip="Chỉ hiện Note" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="5,0,3,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="7" Height="7" Fill="#FF4BA889" />
                        <TextBlock
                            MaxWidth="170"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource MutedTextBrush}"
                            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button
                        x:Name="DriveButton"
                        Height="34"
                        Padding="10,0"
                        Background="White"
                        BorderBrush="#FFCBD9DC"
                        BorderThickness="1"
                        Click="OnDriveClicked"
                        CornerRadius="8"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource MutedTextBrush}"
                        ToolTipService.ToolTip="Đồng bộ thư viện bằng Google Drive appDataFolder">
                        <Button.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="OnDriveChangeClientClicked" Text="Đổi OAuth client…" />
                                <MenuFlyoutItem Click="OnDriveDisconnectClicked" Text="Ngắt kết nối" />
                            </MenuFlyout>
                        </Button.ContextFlyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="15" Glyph="&#xE753;" />
                            <TextBlock x:Name="DriveButtonLabel" VerticalAlignment="Center" Text="Kết nối Drive" />
                        </StackPanel>
                    </Button>
                    <Button
                        Height="34"
                        Padding="12,0"
                        Background="{ThemeResource MedNoteTealBrush}"
                        BorderThickness="0"
                        Click="OnOpenClicked"
                        CornerRadius="8"
                        FontWeight="SemiBold"
                        Foreground="White">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="16" Glyph="&#xE838;" />
                            <TextBlock VerticalAlignment="Center" Text="Mở PDF" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="SidebarPane"
                Grid.Column="0"
                Padding="8"
                Background="#FFFBFCFC"
                BorderBrush="{ThemeResource SubtleBorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="39" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollViewer
                        Grid.Row="0"
                        HorizontalScrollMode="Enabled"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled">
                        <StackPanel
                            Grid.Row="0"
                            Padding="2,1,2,6"
                            Orientation="Horizontal"
                            Spacing="2">
                            <ToggleButton
                                x:Name="PagesTabButton"
                                HorizontalAlignment="Center"
                                Checked="OnPagesTabChecked"
                                Style="{StaticResource RailTabStyle}"
                                ToolTipService.ToolTip="Hình thu nhỏ các trang">
                                <controls:ReaderToolContent IconData="M3 7V5a2 2 0 0 1 2-2h2 M17 3h2a2 2 0 0 1 2 2v2 M21 17v2a2 2 0 0 1-2 2h-2 M7 21H5a2 2 0 0 1-2-2v-2 M7 8h8 M7 12h10 M7 16h6" Foreground="{Binding Foreground, ElementName=PagesTabButton}" />
                            </ToggleButton>
                            <ToggleButton
                                x:Name="OutlineTabButton"
                                HorizontalAlignment="Center"
                                Checked="OnOutlineTabChecked"
                                IsChecked="True"
                                Style="{StaticResource RailTabStyle}"
                                ToolTipService.ToolTip="Mục lục PDF">
                                <controls:ReaderToolContent IconData="M21 12h-8 M21 6H8 M21 18h-8 M3 6v4c0 1.1.9 2 2 2h3 M3 10v6c0 1.1.9 2 2 2h3" Foreground="{Binding Foreground, ElementName=OutlineTabButton}" />
                            </ToggleButton>
                            <ToggleButton
                                x:Name="SearchTabButton"
                                HorizontalAlignment="Center"
                                Checked="OnSearchTabChecked"
                                Style="{StaticResource RailTabStyle}"
                                ToolTipService.ToolTip="Tìm trong tài liệu">
                                <controls:ReaderToolContent IconData="M3 11a8 8 0 1 0 16 0a8 8 0 1 0 -16 0 M0 0 m21 21-4.3-4.3" Foreground="{Binding Foreground, ElementName=SearchTabButton}" />
                            </ToggleButton>
                            <ToggleButton
                                x:Name="BookmarksTabButton"
                                HorizontalAlignment="Center"
                                Checked="OnBookmarksTabChecked"
                                Style="{StaticResource RailTabStyle}"
                                ToolTipService.ToolTip="Đánh dấu">
                                <controls:ReaderToolContent IconData="M0 0 m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" Foreground="{Binding Foreground, ElementName=BookmarksTabButton}" />
                            </ToggleButton>
                            <ToggleButton x:Name="AnnotationsTabButton" Checked="OnAnnotationsTabChecked"
                                Style="{StaticResource RailTabStyle}" ToolTipService.ToolTip="Chú thích">
                                <controls:ReaderToolContent IconData="M12 20h9 M16.5 3.5a2.12 2.12 0 0 1 3 3L9 17l-4 1 1-4Z"
                                    Foreground="{Binding Foreground, ElementName=AnnotationsTabButton}" />
                            </ToggleButton>
                            <Button
                                Width="31"
                                Height="31"
                                HorizontalAlignment="Center"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnHideRailClicked"
                                CornerRadius="7"
                                Foreground="{ThemeResource MutedTextBrush}"
                                ToolTipService.ToolTip="Thu gọn bảng điều hướng">
<controls:ReaderToolContent IconData="M0 0 m15 18-6-6 6-6" Foreground="{ThemeResource MutedTextBrush}" />
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="1">
                        <StackPanel x:Name="OutlinePanel" Padding="9,10" Spacing="9">
                            <TextBlock
                                Foreground="{ThemeResource MedNoteNavyBrush}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Mục lục" />
                            <StackPanel MinHeight="160" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
<controls:ReaderToolContent IconData="M21 12h-8 M21 6H8 M21 18h-8 M3 6v4c0 1.1.9 2 2 2h3 M3 10v6c0 1.1.9 2 2 2h3" Foreground="{ThemeResource MutedTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock
                                    MaxWidth="190"
                                    Foreground="#FF8A999F"
                                    FontSize="11"
                                    Text="PDF này không có mục lục nhúng hoặc mục lục chưa được đọc."
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <ListView
                            x:Name="SidebarPagesList"
                            Padding="0"
                            Margin="2,5"
                            IsItemClickEnabled="True"
                            ItemClick="OnSidebarPageClicked"
                            ItemsSource="{x:Bind ViewModel.Pages, Mode=OneWay}"
                            SelectionMode="Single"
                            HorizontalContentAlignment="Center"
                            Visibility="Collapsed">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="2,0" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel CacheLength="1" Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PdfPageViewModel">
<StackPanel Padding="0,7" HorizontalAlignment="Center" Spacing="5"><controls:PdfThumbnailPresenter/><TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="{ThemeResource MutedTextBrush}" Text="{x:Bind Number}"/></StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid x:Name="SearchPanel" Padding="9,12" RowSpacing="9" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Foreground="{ThemeResource MedNoteNavyBrush}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Tìm trong tài liệu" />
                            <Border
                                Grid.Row="1"
                                Height="36"
                                Padding="8,0"
                                Background="White"
                                BorderBrush="{ThemeResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
<controls:ReaderToolContent IconData="M3 11a8 8 0 1 0 16 0a8 8 0 1 0 -16 0 M0 0 m21 21-4.3-4.3" Foreground="{ThemeResource MutedTextBrush}" HorizontalAlignment="Center" />
                                    <TextBox
                                        x:Name="SearchTextBox"
                                        Grid.Column="1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="11"
                                        PlaceholderText="Nhập từ cần tìm…"
                                        KeyDown="OnSearchKeyDown" />
                                    <Button Grid.Column="2" Content="Tìm" Click="OnSearchSubmitClicked" Padding="5,2" />
                                </Grid>
                            </Border>
                            <Grid Grid.Row="2" ColumnSpacing="7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ProgressRing
                                    Width="14"
                                    Height="14"
                                    IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="10"
                                    Foreground="{ThemeResource MutedTextBrush}"
                                    Text="{x:Bind ViewModel.SearchStatus, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </Grid>
                            <ListView
                                Grid.Row="3"
                                IsItemClickEnabled="True"
                                ItemClick="OnSearchResultClicked"
                                ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:PdfSearchMatch">
                                        <StackPanel Padding="4,7" Spacing="3">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource MedNoteTealBrush}"
                                                Text="{x:Bind PageNumber, Mode=OneWay}" />
                                            <TextBlock
                                                MaxLines="3"
                                                FontSize="10"
                                                Foreground="{ThemeResource MutedTextBrush}"
                                                Text="{x:Bind Snippet, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <Grid x:Name="AnnotationsPanel" Visibility="Collapsed" Padding="8,10" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Chú thích" FontWeight="SemiBold" />
                            <ComboBox x:Name="AnnotationFilter" Grid.Row="1" SelectedIndex="0"
                                SelectionChanged="OnAnnotationFilterChanged" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Toàn bộ tài liệu" />
                                <ComboBoxItem Content="Trang hiện tại" />
                            </ComboBox>
                            <TextBlock x:Name="AnnotationListStatus" Grid.Row="2" FontSize="11" TextWrapping="Wrap" />
                            <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="AnnotationItems" Spacing="6" />
                            </ScrollViewer>
                        </Grid>
                        <StackPanel x:Name="BookmarksPanel" Visibility="Collapsed">
                            <TextBlock
                                Margin="11,12,11,5"
                                Foreground="{ThemeResource MedNoteNavyBrush}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Đánh dấu trang" />
                            <ListView
                                x:Name="BookmarksList"
                                IsItemClickEnabled="True"
                                ItemClick="OnBookmarkItemClicked"
                                ItemsSource="{x:Bind ViewModel.Bookmarks, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="10,8" Orientation="Horizontal" Spacing="8">
<controls:ReaderToolContent IconData="M0 0 m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" Foreground="{ThemeResource MutedTextBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding}" />
                                            <Button Content="×" Click="OnRemoveBookmarkClicked" Padding="5,0"
                                                ToolTipService.ToolTip="Xóa đánh dấu" AutomationProperties.Name="Xóa đánh dấu" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="WorkspaceGrid" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ReaderWorkspaceColumn" Width="*" />
                    <ColumnDefinition x:Name="WorkspaceDividerColumn" Width="0" />
                    <ColumnDefinition x:Name="NoteWorkspaceColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="ReaderPane" Grid.Column="0" IsTabStop="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Padding="10,3"
                    Background="#FFFDFEFE"
                    BorderBrush="{ThemeResource SubtleBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="39" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="Auto" MinHeight="39" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer
                                HorizontalScrollMode="Enabled"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Disabled"
                                ZoomMode="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Button
                                        x:Name="ShowReaderRailButton"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Click="OnShowRailClicked"
                                        ToolTipService.ToolTip="Hiện bảng điều hướng"
                                        AutomationProperties.Name="Hiện bảng điều hướng"
                                        Visibility="Collapsed">
                                        <controls:ReaderToolContent
                                            IconData="M5 3h14q2 0 2 2v14q0 2 -2 2h-14q-2 0 -2 -2v-14q0 -2 2 -2Z M9 3v18 M0 0 m14 9 3 3-3 3"
                                            Foreground="{Binding Foreground, ElementName=ShowReaderRailButton}"
                                            Label=""
                                            IsActive="False" />
                                    </Button>
                                    <TextBlock
                                        MaxWidth="180"
                                        Margin="3,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource ToolbarTextBrush}"
                                        Text="{x:Bind ViewModel.DocumentName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        x:Name="ExportPdfButton"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Click="OnExportClicked"
                                        ToolTipService.ToolTip="Xuất PDF có chú thích"
                                        AutomationProperties.Name="Xuất PDF có chú thích"
                                        IsEnabled="False">
                                        <controls:ReaderToolContent
                                            IconData="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10 12 15 17 10 M12 15L12 3"
                                            Foreground="{Binding Foreground, ElementName=ExportPdfButton}"
                                            Label="Xuất PDF"
                                            IsActive="True" />
                                    </Button>
                                    <Button
                                        x:Name="PrintPdfButton"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        ToolTipService.ToolTip="In PDF — chưa hỗ trợ"
                                        AutomationProperties.Name="In PDF — chưa hỗ trợ"
                                        IsEnabled="False">
                                        <controls:ReaderToolContent
                                            IconData="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2 M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6 M7 14h10q1 0 1 1v6q0 1 -1 1h-10q-1 0 -1 -1v-6q0 -1 1 -1Z"
                                            Foreground="{Binding Foreground, ElementName=PrintPdfButton}"
                                            Label=""
                                            IsActive="False" />
                                    </Button>
                                    <Border
                                        Width="1"
                                        Height="22"
                                        Margin="3,0"
                                        Background="{ThemeResource SubtleBorderBrush}" />
                                    <Border
                                        Height="32"
                                        BorderBrush="{ThemeResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button
                                                x:Name="PreviousPageButton"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                Click="OnPreviousPageClicked"
                                                ToolTipService.ToolTip="Trang trước"
                                                AutomationProperties.Name="Trang trước"
                                                IsEnabled="False">
                                                <controls:ReaderToolContent
                                                    IconData="M0 0 m15 18-6-6 6-6"
                                                    Foreground="{Binding Foreground, ElementName=PreviousPageButton}"
                                                    Label=""
                                                    IsActive="False" />
                                            </Button>
                                            <NumberBox
                                                x:Name="PageNumberBox"
                                                Width="46"
                                                MinWidth="0"
                                                Height="30"
                                                MinHeight="0"
                                                Padding="2,0"
                                                FontSize="11"
                                                Background="#FFF2F5F6"
                                                BorderThickness="0"
                                                Minimum="1"
                                                SpinButtonPlacementMode="Hidden"
                                                ValueChanged="OnPageNumberChanged"
                                                AutomationProperties.Name="Số trang"
                                                IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}" />
                                            <TextBlock
                                                Text="/"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{ThemeResource MutedTextBrush}" />
                                            <TextBlock
                                                MinWidth="22"
                                                Text="{x:Bind ViewModel.PageCount, Mode=OneWay}"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{ThemeResource ToolbarTextBrush}" />
                                            <Button
                                                x:Name="NextPageButton"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                Click="OnNextPageClicked"
                                                ToolTipService.ToolTip="Trang sau"
                                                AutomationProperties.Name="Trang sau"
                                                IsEnabled="False">
                                                <controls:ReaderToolContent
                                                    IconData="M0 0 m9 18 6-6-6-6"
                                                    Foreground="{Binding Foreground, ElementName=NextPageButton}"
                                                    Label=""
                                                    IsActive="False" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Height="32"
                                        BorderBrush="{ThemeResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                        <StackPanel Orientation="Horizontal">
                                            <Button
                                                x:Name="ZoomOutButton"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                Click="OnZoomOutClicked"
                                                ToolTipService.ToolTip="Thu nhỏ"
                                                AutomationProperties.Name="Thu nhỏ"
                                                IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}">
                                                <controls:ReaderToolContent
                                                    IconData="M5 12h14"
                                                    Foreground="{Binding Foreground, ElementName=ZoomOutButton}"
                                                    Label=""
                                                    IsActive="False" />
                                            </Button>
                                            <TextBlock
                                                Width="48"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                TextAlignment="Center"
                                                Text="{x:Bind ViewModel.ZoomLabel, Mode=OneWay}" />
                                            <Button
                                                x:Name="ZoomInButton"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                Click="OnZoomInClicked"
                                                ToolTipService.ToolTip="Phóng to"
                                                AutomationProperties.Name="Phóng to"
                                                IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}">
                                                <controls:ReaderToolContent
                                                    IconData="M5 12h14 M12 5v14"
                                                    Foreground="{Binding Foreground, ElementName=ZoomInButton}"
                                                    Label=""
                                                    IsActive="False" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
