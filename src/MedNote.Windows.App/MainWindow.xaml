                                                    x:Name="FitPageButton"
                                                    Content="Vừa toàn trang"
                                                    Click="OnFitPageChecked"
                                                    Style="{StaticResource ReaderViewOptionStyle}" />
                                            </StackPanel>
                                            <Button
