                                    <Button
                                        x:Name="AnnotationColorButton"
                                        IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                                        AutomationProperties.Name="Màu chú thích"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        ToolTipService.ToolTip="Màu annotation">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Click="OnAnnotationColorClicked" Tag="#1c2933" Text="Đen" />
                                                <MenuFlyoutItem Click="OnAnnotationColorClicked" Tag="#c94b50" Text="Đỏ" />
                                                <MenuFlyoutItem Click="OnAnnotationColorClicked" Tag="#0e6b70" Text="Xanh ngọc" />
